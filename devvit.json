{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "overprint-colors",
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_POST",
        "SUBMIT_COMMENT",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    },
    "journeys": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      },
      "gallery": {
        "entry": "gallery.html"
      },
      "shop": {
        "entry": "shop.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's print",
        "description": "Overprint: create today's daily (once per day)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Post a print for a date\u2026",
        "description": "Overprint: create the daily for any date (testing)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-for-date"
      }
    ]
  },
  "forms": {
    "postForDate": "/internal/form/post-for-date"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "overprint_colors_dev"
  }
}
